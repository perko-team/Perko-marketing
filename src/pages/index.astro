---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Solution from '../components/sections/Solution.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Demo from '../components/sections/Demo.astro';
import Business from '../components/sections/Business.astro';
import Journey from '../components/sections/Journey.astro';
import Network from '../components/sections/Network.astro';
import Join from '../components/sections/Join.astro';
import Faq from '../components/sections/Faq.astro';
import Closing from '../components/sections/Closing.astro';
import StampTrail from '../components/StampTrail.astro';
---
<Base title="Perko - כל ההטבות שלך במקום אחד" description="Perko מחברת תוכניות נאמנות של עסקים מקומיים לחוויה דיגיטלית אחת: צוברים חותמות בסריקת QR, עוקבים אחרי ההתקדמות ומממשים הטבות. גישה מוקדמת לעסקים, ההצטרפות חינם.">
  <span id="top"></span>
  <Header />
  <main id="main">
    <Hero />
    <Problem />
    <Journey />
    <Solution />
    <HowItWorks />
    <Demo />
    <Business />
    <Network />
    <Join />
    <Faq />
  </main>
  <Closing />
  <StampTrail />
</Base>
