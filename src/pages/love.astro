---
// The neighbourhood love map: residents of Emek Refaim and Derech Beit Lehem vote for the local business they love.
// Votes go to /api/love (Supabase). Reasons appear only after Perko approves them.
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import businesses from '../data/love-businesses.json';

// Schematic geometry (viewBox 600 x 820). Each street is a straight line, even numbers on one side and odd on the other. Not to scale.
const streets = {
  emek: { label: 'עמק רפאים', x1: 190, y1: 70, x2: 230, y2: 760, },
  beitlehem: { label: 'דרך בית לחם', x1: 400, y1: 70, x2: 450, y2: 760, },
} as const;
// Pins are spread evenly along each street in house-number order, so close numbers don't pile up.
const pins = (Object.keys(streets) as (keyof typeof streets)[]).flatMap((k) => {
  const s = streets[k];
  const list = businesses.filter((b) => b.street === k).sort((a, b) => a.num - b.num);
  return list.map((b, i) => {
    const t = 0.07 + (0.86 * i) / Math.max(1, list.length - 1);
    const side = b.num % 2 ? 1 : -1;
    return { ...b, x: Math.round(s.x1 + (s.x2 - s.x1) * t + side * 24), y: Math.round(s.y1 + (s.y2 - s.y1) * t) };
  });
});
const byStreet = (k: string) => businesses.filter((b) => b.street === k).sort((a, b) => a.name.localeCompare(b.name, 'he'));
---
<Base title="מפת האהבה של השכונה - Perko" description="איזה עסק בעמק רפאים ובדרך בית לחם אתם הכי אוהבים? הצביעו, ותראו על המפה את העסקים שהשכונה אוהבת.">
  <header class="lv-top">
    <div class="wrap lv-top__bar">
      <a href="/" aria-label="Perko, לעמוד הבית"><Wordmark label={false} /></a>
      <a class="btn btn--small" href="/#join">יש לכם עסק? הצטרפו</a>
    </div>
  </header>

  <main id="main" class="lv">
    <section class="lv-hero wrap">
      <p class="lv-over">עמק רפאים · דרך בית לחם</p>
      <h1 class="display lv-hero__title"><span class="line">מפת האהבה</span><span class="line">של השכונה</span></h1>
      <p class="lead lv-hero__sub">לכל אחד יש את המקום שלו. בית הקפה שמכיר את ההזמנה שלכם, המאפייה של שישי בבוקר, חנות הפרחים מהפינה. ספרו לנו איזה עסק אתם הכי אוהבים, והשכונה תראה את זה על המפה.</p>
      <p class="lv-total small" data-total aria-live="polite"></p>
    </section>

    <section class="lv-grid wrap" aria-label="המפה וההצבעה">
      <div class="lv-map on-ink">
        <svg class="lv-map__svg" viewBox="0 0 600 820" role="img" aria-labelledby="map-title map-desc">
          <title id="map-title">מפה סכמטית של עמק רפאים ודרך בית לחם</title>
          <desc id="map-desc">כל נקודה היא עסק ברחוב. ככל שהנקודה גדולה יותר, יותר אנשים הצביעו לו. הרשימה המלאה עם מספר הקולות מופיעה מתחת למפה.</desc>
          <g class="lv-street">
            {Object.entries(streets).map(([k, s]) => (
              <g>
                <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} />
                <text class="lv-street__label" x={s.x1} y={s.y1 - 26} text-anchor="middle">{s.label}</text>
              </g>
            ))}
          </g>
          <g class="lv-pins">
            {pins.map((p) => (
              <g class="lv-pin" data-pin={p.key} transform={`translate(${p.x} ${p.y})`} tabindex="-1">
                <circle class="lv-pin__halo" r="10" />
                <circle class="lv-pin__dot" r="7" />
                <text class="lv-pin__label" x={p.num % 2 ? -14 : 14} y="5" text-anchor={p.num % 2 ? 'start' : 'end'}>{p.name}</text>
                <text class="lv-pin__count" y="5" text-anchor="middle" data-count></text>
              </g>
            ))}
          </g>
        </svg>
        <p class="lv-map__bar small"><span>מפה סכמטית, לא בקנה מידה</span><span>נקודה גדולה = יותר קולות</span></p>
      </div>

      <div class="lv-side">
        <form class="lv-form" data-love-form novalidate>
          <h2 class="lv-h2">איזה עסק אתם הכי אוהבים?</h2>
          <label class="lv-field">
            <span>העסק</span>
            <select name="key" required data-love-select>
              <option value="" disabled selected>בחרו עסק</option>
              <optgroup label="עמק רפאים">{byStreet('emek').map((b) => <option value={b.key}>{b.name}</option>)}</optgroup>
              <optgroup label="דרך בית לחם">{byStreet('beitlehem').map((b) => <option value={b.key}>{b.name}</option>)}</optgroup>
              <option value="other">עסק אחר בשכונה</option>
            </select>
          </label>
          <label class="lv-field" data-other hidden>
            <span>שם העסק</span>
            <input name="name" type="text" maxlength="60" autocomplete="off" />
          </label>
          <label class="lv-field">
            <span>למה דווקא הוא? <small class="muted">(לא חובה)</small></span>
            <textarea name="reason" rows="3" maxlength="140" placeholder="למשל: הם זוכרים איך אני שותה את הקפה"></textarea>
            <small class="lv-count muted" data-reason-count>0/140</small>
          </label>
          <label class="lv-trap" aria-hidden="true">אתר<input name="website" tabindex="-1" autocomplete="off" /></label>
          <button class="btn lv-submit" type="submit">הצבעה</button>
          <p class="lv-msg small" data-love-msg role="status" aria-live="polite"></p>
          <div class="lv-done" data-love-done hidden>
            <p class="lv-done__title">תודה, הקול נספר.</p>
            <p class="small" data-love-done-note></p>
            <button class="btn btn--lime" type="button" data-love-share>שתפו את המפה</button>
            <button class="text-link lv-again" type="button" data-love-again>להצביע לעסק נוסף</button>
          </div>
          <p class="lv-fine small muted">אפשר להצביע עד 5 פעמים ביום. שמות של עסקים שלא ברשימה, וכל הנימוקים, מופיעים במפה רק אחרי שנעבור עליהם.</p>
        </form>

        <section class="lv-board" aria-labelledby="board-title">
          <h2 id="board-title" class="lv-h2">הכי אהובים כרגע</h2>
          <ol class="lv-board__list" data-board></ol>
        </section>
      </div>
    </section>

    <section class="lv-reasons wrap" aria-labelledby="reasons-title" data-reasons-wrap hidden>
      <h2 id="reasons-title" class="head">מה השכונה כותבת</h2>
      <ul class="lv-reasons__list" data-reasons></ul>
    </section>

    <section class="lv-biz wrap" aria-labelledby="biz-title">
      <div>
        <h2 id="biz-title" class="head">העסק שלכם על המפה?</h2>
        <p class="lead">הלקוחות כבר אוהבים אתכם. Perko עוזרת להחזיר אותם שוב ושוב, עם כרטיסיית חותמות דיגיטלית אחת לכל השכונה. בגישה מוקדמת, ההצטרפות בחינם.</p>
      </div>
      <a class="btn btn--lime" href="/#join">
        הצטרפו בחינם
        <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </section>

    <p class="lv-note wrap small muted">העסקים ברשימה הם עסקים בעמק רפאים ובדרך בית לחם, והם מופיעים כאן כדי שיהיה קל להצביע. הופעה במפה לא אומרת שהעסק משתתף ב-Perko או קשור אליה. בעלי עסק שמעדיפים לא להופיע כאן מוזמנים לכתוב ל-<a href="mailto:hello@getperko.com">hello@getperko.com</a> ונסיר את העסק.</p>
  </main>
</Base>

<script>
  import '../scripts/love.ts';
</script>

<style>
  :global(body) { background: var(--paper); }
  .lv [hidden] { display: none !important; }
  .lv-top { background: var(--paper); border-bottom: 1px solid var(--pale-strong); }
  .lv-top__bar { display: flex; justify-content: space-between; align-items: center; min-height: 72px; }
  .lv-top__bar :global(.wordmark) { font-size: 34px; }

  .lv-hero { background: var(--lime); border-radius: var(--radius); margin-top: 12px; margin-bottom: 12px; padding: clamp(40px, 6vw, 96px) clamp(24px, 4.4vw, 72px) 36px; }
  .lv-over { font-weight: 700; font-size: 15px; letter-spacing: 0.02em; color: var(--muted); }
  .lv-hero__title { margin-top: 16px; }
  .lv-hero__sub { margin-top: 28px; max-width: 46ch; }
  .lv-total { margin-top: 20px; font-weight: 700; min-height: 1.5em; }

  .lv-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 12px; align-items: start; }
  .lv-map { background: var(--ink); color: var(--paper); border-radius: var(--radius); overflow: hidden; position: sticky; top: 12px; }
  .lv-map__svg { display: block; width: 100%; height: auto; max-height: calc(100svh - 90px); font-family: var(--font); }
  .lv-street line { stroke: var(--ink-raised); stroke-width: 34; stroke-linecap: round; }
  .lv-street__label { fill: var(--slate-on-ink); font-size: 17px; font-weight: 700; }
  .lv-pin { cursor: pointer; outline: none; }
  .lv-pin__dot { fill: var(--lime); transition: r 600ms var(--ease-expo); }
  .lv-pin__halo { fill: var(--lime); opacity: 0; transition: opacity var(--t-ui) ease, r 600ms var(--ease-expo); }
  .lv-pin__label { fill: var(--paper); font-size: 14px; font-weight: 600; opacity: 0.78; transition: opacity var(--t-ui) ease; paint-order: stroke; stroke: var(--ink); stroke-width: 4px; }
  .lv-pin__count { fill: var(--ink); font-size: 13px; font-weight: 800; pointer-events: none; }
  .lv-pin.is-zero .lv-pin__dot { fill: var(--ink); stroke: var(--lime); stroke-width: 2; }
  .lv-pin:hover .lv-pin__label, .lv-pin.is-picked .lv-pin__label, .lv-pin:focus-visible .lv-pin__label { opacity: 1; }
  .lv-pin.is-picked .lv-pin__halo { opacity: 0.25; }
  .lv-map__bar { display: flex; justify-content: space-between; gap: 16px; padding: 14px 22px; background: var(--ink-raised); color: var(--slate-on-ink); }

  .lv-side { display: grid; gap: 12px; }
  .lv-form, .lv-board { background: var(--white); border: 1px solid var(--pale-strong); border-radius: var(--radius); padding: clamp(24px, 3vw, 40px); }
  .lv-form { background: var(--lime); border: 0; }
  .lv-h2 { font-size: 28px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
  .lv-field { display: grid; gap: 8px; margin-top: 20px; font-weight: 700; position: relative; }
  .lv-field select, .lv-field input, .lv-field textarea {
    font: inherit; font-weight: 400; font-size: 17px; color: var(--ink); background: var(--paper);
    border: 2px solid var(--ink); border-radius: var(--radius-sm); padding: 12px 14px; width: 100%;
  }
  .lv-field textarea { resize: vertical; min-height: 96px; }
  .lv-field select:focus-visible, .lv-field input:focus-visible, .lv-field textarea:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  .lv-count { justify-self: end; font-weight: 400; }
  .lv-trap { position: absolute; inset-inline-start: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lv-submit { margin-top: 24px; width: 100%; }
  .lv-msg { margin-top: 12px; min-height: 1.5em; font-weight: 600; }
  .lv-done { margin-top: 8px; display: grid; gap: 12px; justify-items: start; }
  .lv-done__title { font-size: 24px; font-weight: 800; }
  .lv-done .btn--lime { background: var(--ink); color: var(--lime); }
  .lv-again { background: none; border: 0; padding: 4px 0; font: inherit; font-weight: 700; color: var(--ink); cursor: pointer; }
  .lv-fine { margin-top: 18px; }

  .lv-board__list { list-style: none; margin-top: 18px; display: grid; gap: 2px; }
  .lv-board__list :global(li) { display: grid; grid-template-columns: 28px 1fr auto; column-gap: 12px; row-gap: 8px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--pale); }
  .lv-board__list :global(button) { display: grid; text-align: start; background: none; border: 0; padding: 0; font: inherit; font-weight: 700; color: var(--ink); cursor: pointer; }
  .lv-board__list :global(button:focus-visible) { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }
  .lv-board__list :global(.lv-board__rank) { font-weight: 800; color: var(--muted); font-variant-numeric: tabular-nums; }
  .lv-board__list :global(.lv-board__bar) { grid-column: 2 / 4; height: 6px; border-radius: 3px; background: var(--pale); overflow: hidden; }
  .lv-board__list :global(.lv-board__bar span) { display: block; height: 100%; background: var(--ink); width: 0; transition: width 800ms var(--ease-expo); }
  .lv-board__list :global(.lv-board__votes) { font-weight: 800; font-variant-numeric: tabular-nums; }
  .lv-board__list :global(.lv-board__street) { font-weight: 400; font-size: 14px; color: var(--muted); }
  .lv-board__list :global(li.small) { display: block; }

  .lv-reasons { margin-top: var(--gap-section); }
  .lv-reasons__list { list-style: none; margin-top: 32px; columns: 3 280px; column-gap: 12px; }
  .lv-reasons__list :global(li) { break-inside: avoid; margin-bottom: 12px; background: var(--white); border: 1px solid var(--pale-strong); border-radius: var(--radius-sm); padding: 20px 22px; }
  .lv-reasons__list :global(q) { display: block; font-size: 19px; line-height: 1.45; quotes: '״' '״'; }
  .lv-reasons__list :global(b) { display: block; margin-top: 10px; font-size: 15px; color: var(--muted); }
  .lv-biz { margin-top: var(--gap-section); background: var(--ink); color: var(--paper); border-radius: var(--radius); padding: clamp(32px, 5vw, 72px); display: flex; gap: 32px; align-items: end; justify-content: space-between; flex-wrap: wrap; }
  .lv-biz .lead { margin-top: 18px; max-width: 48ch; color: var(--slate-on-ink); }
  .lv-note { margin-block: 28px 56px; max-width: 90ch; }

  @media (prefers-reduced-motion: reduce) {
    .lv-pin__dot, .lv-pin__halo, .lv-board__list :global(.lv-board__bar span) { transition: none; }
  }
  @media (max-width: 900px) {
    .lv-grid { grid-template-columns: 1fr; }
    .lv-map { position: static; }
    .lv-map__svg { max-height: none; }
    .lv-pin__label { font-size: 17px; }
    .lv-map__bar { flex-direction: column; gap: 2px; padding: 12px 16px; }
    .lv-top__bar .btn { padding: 0 14px; }
  }
</style>
