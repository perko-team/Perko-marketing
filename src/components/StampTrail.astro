---
// A fixed card that fills with one stamp per section read. Decorative page progress: it carries no reward and no real count.
const stations = [
  { id: 'problem' }, { id: 'solution' }, { id: 'how' }, { id: 'demo' },
  { id: 'business' }, { id: 'journey' }, { id: 'network' }, { id: 'join' }, { id: 'faq' },
];
---
<aside class="trail" data-trail={stations.map((s) => s.id).join(',')} aria-hidden="true">
  <div class="trail__card">
    <div class="trail__head"><span>סיור בדף</span><b data-trail-count>0/{stations.length}</b></div>
    <ol class="trail__slots">
      {stations.map(() => <li data-slot><i></i></li>)}
    </ol>
  </div>
</aside>

<style>
  .trail {
    position: fixed; inset-inline-end: 16px; bottom: 16px; z-index: 40; pointer-events: none;
    transition: opacity 320ms var(--ease-out), translate 320ms var(--ease-out);
  }
  .trail.is-away, .trail.is-idle { opacity: 0; translate: 0 12px; }
  .trail__card {
    background: var(--ink); color: var(--lime); border-radius: 16px;
    padding: 12px 14px; width: 248px; transition: background-color 500ms var(--ease-out), color 500ms var(--ease-out);
  }
  .trail__head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 10px; font-size: 13px; font-weight: 600; color: var(--slate-on-ink); }
  .trail__head b { color: var(--lime); font-variant-numeric: tabular-nums; }
  .trail__slots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(9, 1fr); gap: 6px; }
  .trail__slots i {
    display: block; aspect-ratio: 1; border-radius: 50%;
    border: 1.5px solid var(--slate-on-ink); transition: background-color 240ms var(--ease-out), border-color 240ms var(--ease-out);
  }
  .trail__slots [data-slot].is-on i { background: var(--lime); border-color: var(--lime); }

  /* Complete: the card turns lime, the way a finished card does at the counter. */
  .trail.is-complete .trail__card { background: var(--lime); color: var(--ink); }
  .trail.is-complete .trail__head { color: var(--muted); }
  .trail.is-complete .trail__head b { color: var(--ink); }
  .trail.is-complete .trail__slots [data-slot].is-on i { background: var(--ink); border-color: var(--ink); }
  .trail.is-complete .trail__slots i { border-color: var(--ink); }

  @media (prefers-reduced-motion: no-preference) {
    .trail__slots [data-slot].is-on i { animation: land 520ms var(--ease-expo) both; }
    @keyframes land {
      0% { transform: scale(1.9); opacity: 0; }
      55% { transform: scale(0.9); opacity: 1; }
      100% { transform: scale(1); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trail { display: none; }
  }
  @media (max-width: 640px) {
    .trail { inset-inline: 12px; bottom: 12px; }
    .trail__card { width: auto; padding: 8px 10px; }
    .trail__head { display: none; }
  }
</style>
